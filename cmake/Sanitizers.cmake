function(ome_enable_sanitizers target)
  if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
    return()
  endif()

  set(OME_SANITIZER_FLAGS "")
  if(OME_ENABLE_ASAN)
    list(APPEND OME_SANITIZER_FLAGS -fsanitize=address -fno-omit-frame-pointer)
  endif()
  if(OME_ENABLE_UBSAN)
    list(APPEND OME_SANITIZER_FLAGS -fsanitize=undefined)
  endif()
  if(OME_ENABLE_TSAN)
    list(APPEND OME_SANITIZER_FLAGS -fsanitize=thread)
  endif()

  if(OME_SANITIZER_FLAGS)
    target_compile_options(${target} PRIVATE ${OME_SANITIZER_FLAGS})
    target_link_options(${target} PRIVATE ${OME_SANITIZER_FLAGS})
  endif()
endfunction()
